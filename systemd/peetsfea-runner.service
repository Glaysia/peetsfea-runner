[Unit]
Description=Peets FEA Runner — EDT 컨트롤 플레인 (동시 ~100 정상상태 가동)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mnt/8tb/peetsfea-runner
# 컨트롤 플레인: 9 SLURM 잡 상시 유지 + 대시보드:8080 + Intake:7875 + 잡 재기동/10h 만료.
ExecStart=%h/mnt/8tb/peetsfea-runner/.venv/bin/python -m peetsfea_runner.edt_control_plane
Environment=EDT_DB_PATH=%h/edt-deploy/results.duckdb
Environment=EDT_ARCHIVE_ROOT=%h/mnt/8tb/edt-archive
# 로컬 8TB 마운트 여유(~1.4TB)에 맞춘 아카이브 FIFO 상한(1TB). 디스크 늘면 키울 것.
Environment=EDT_ARCHIVE_BUFFER_BYTES=1099511627776
Environment=EDT_SSH_HOST=gate1-harry261
Environment=EDT_JOB_COUNT=9
Environment=EDT_DASHBOARD_PORT=8080
Environment=EDT_INTAKE_PORT=7875
Restart=always
RestartSec=10
# 상시 가동: 실행시간 상한 없음(잡 수명 10h는 오케스트레이터가 내부에서 관리).
TimeoutStopSec=120s
# 하드 킬 대비: 잔류 peetsfea-edt 잡을 safe-scancel로 정리(raw scancel 금지 — /enroot 잔재 방지).
# graceful SIGTERM으로 slot_service trap이 /enroot를 청소할 시간을 주고, 끝내 안 죽으면 강제 종료.
ExecStopPost=/usr/bin/ssh gate1-harry261 bash %h/edt-deploy/safe_scancel.sh

[Install]
WantedBy=default.target
