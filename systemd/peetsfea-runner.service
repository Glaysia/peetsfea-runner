[Unit]
Description=Peets FEA Runner — EDT 컨트롤 플레인 (동시 ~100 정상상태 가동)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 배포 체크아웃이 원래 위치. WorkingDirectory=cwd → peetsfea_runner를 여기서 import(FF로 최신 유지).
# venv는 uv로 재생성(duckdb+psutil; 데몬은 control-plane만 돌아 경량이면 충분).
WorkingDirectory=%h/mnt/8tb/peetsfea-runner
# 컨트롤 플레인: 9 SLURM 잡 상시 유지 + 대시보드:8080 + Intake:7875 + 잡 재기동/10h 만료.
ExecStart=%h/mnt/8tb/peetsfea-runner/.venv/bin/python -m peetsfea_runner.edt_control_plane
Environment=EDT_DB_PATH=%h/edt-deploy/results.duckdb
Environment=EDT_ARCHIVE_ROOT=%h/mnt/8tb/edt-archive
# 로컬 8TB 마운트 여유(~1.4TB)에 맞춘 아카이브 FIFO 상한(1TB). 디스크 늘면 키울 것.
Environment=EDT_ARCHIVE_BUFFER_BYTES=1099511627776
Environment=EDT_SSH_HOST=gate1-harry261
Environment=EDT_JOB_COUNT=9
Environment=EDT_DASHBOARD_PORT=8080
Environment=EDT_INTAKE_PORT=7875
# 대시보드에 노출할 결과 버전(빈 값=전 버전). 분리 운영(peetsfea-web/keeper)으로 가면 이 유닛은 대체됨.
Environment=EDT_DASHBOARD_PEETSFEA_VERSION=0.3.7
Restart=always
RestartSec=10
# 상시 가동: 실행시간 상한 없음(잡 수명 10h는 오케스트레이터가 내부에서 관리).
# teardown은 control_plane이 단계별 best-effort + 아카이브 flush 45s 시한으로 자체 제한(코드).
# 그래도 'stop→failed'가 안 나게 충분한 여유를 준다(과거 120s 초과로 SIGKILL→failed 발생).
TimeoutStopSec=200s
# 하드 킬 대비: 잔류 peetsfea-edt 잡을 safe-scancel로 정리(raw scancel 금지 — /enroot 잔재 방지).
# graceful SIGTERM으로 잡 스크립트 trap이 /enroot를 청소할 시간을 주고, 끝내 안 죽으면 강제 종료.
# ssh가 gate $HOME에 랜딩하므로 상대경로(=gate의 ~/edt-deploy). %h(로컬 home)는 gate에서 무효라 쓰지 않는다.
ExecStopPost=/usr/bin/ssh gate1-harry261 bash edt-deploy/safe_scancel.sh

[Install]
WantedBy=default.target
